# Gemini — leave empty to use Ali's built-in rule-based replies
GEMINI_API_KEY=
# Optional alias supported too:
# GOOGLE_API_KEY=

CHAT_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=models/text-embedding-004
MASCOT_NAME=Ali
ADMIN_TOKEN=change-this-long-random-string
# Comma-separated frontend origins (no trailing slash). Add your Vercel URL in production.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DB_PATH=portfolio.db
